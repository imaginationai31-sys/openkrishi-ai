# OpenKrishi AI local/deployment configuration.
# Never put a real secret in this file. Set production secrets in Render.
# Required: comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=https://openkrishi-ai.hatchable.site


# Optional: Sentry DSN for production error tracking. Leave blank to disable.
SENTRY_DSN=

# Required: OpenAI API key for crop vision and advisory.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_ADVISORY_MODEL=gpt-5-mini

# Required: Sarvam AI key for speech-to-text and text-to-speech.
SARVAM_API_KEY=replace-with-sarvam-api-key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Optional public provider URLs; override only for a controlled proxy/mirror.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# Resource and abuse controls.
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=10485760
OUTBOUND_TIMEOUT_SECONDS=45
WEATHER_TIMEOUT_SECONDS=15
AI_RATE_LIMIT=10/minute
VOICE_RATE_LIMIT=6/minute
VISION_RATE_LIMIT=6/minute
