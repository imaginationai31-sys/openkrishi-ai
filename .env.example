# OpenKrishi AI local/deployment configuration
# Never commit a real API key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Set to true only if you want the old deterministic advisory engine as an emergency fallback.
GEMINI_FALLBACK_TO_RULES=false
